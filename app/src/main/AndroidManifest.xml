<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".di.MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_study_connect"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_study_connect_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyConnect"
        tools:targetApi="31">
        <activity
            android:name=".ui.class_ui.assignment.ViewGuruActivity"
            android:exported="false"
            android:label="@string/title_activity_view"
            android:theme="@style/Theme.StudyConnect.NoActionBar" />
        <activity
            android:name=".ui.class_ui.assignment.FormPertanyaanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.forum.ViewForumActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.assignment.FormMateriActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.assignment.FormTugasActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.forum.FormForumActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.InfoClassActivity"
            android:exported="false" />
        <activity
            android:name=".ui.class_ui.JoinClassActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Aktivitas lainnya -->
        <activity android:name=".ui.home.Drawer" />
        <activity android:name=".ui.auth.SignInActivity" />
        <activity android:name=".ui.auth.SignUpActivity" />
        <activity android:name=".ui.class_ui.FormClassActivity" />
        <activity android:name=".ui.class_ui.assignment.ViewStudentAssignmentActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.studyconnect.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>