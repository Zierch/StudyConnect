<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/md_theme_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contraint_forum_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="50dp"
                app:layout_constraintBottom_toBottomOf="@id/contraint_forum_card"
                app:layout_constraintStart_toStartOf="@id/contraint_forum_card"
                app:layout_constraintTop_toTopOf="@id/contraint_forum_card">

                <ImageView
                    android:id="@+id/iv_profile_pict"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/powder_smoke"
                    android:contentDescription="@string/text_profile" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/text_nama_anda"
                app:layout_constraintStart_toEndOf="@+id/materialCardView3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_jam_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="@string/text_jam"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/materialCardView3"
                app:layout_constraintTop_toBottomOf="@+id/tv_profile_name" />

            <ImageView
                android:id="@+id/iv_edit_forum"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_more"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/text_forum"
                app:layout_constraintBottom_toBottomOf="@id/contraint_forum_card"
                app:layout_constraintEnd_toEndOf="@id/contraint_forum_card"
                app:layout_constraintTop_toTopOf="@id/contraint_forum_card" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_deskripsi_forum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/text_deskripsi_pengumuman" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_outline" />

        <TextView
            android:id="@+id/tv_add_forum_komen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/text_tambah_komentar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>