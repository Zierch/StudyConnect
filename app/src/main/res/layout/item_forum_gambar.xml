<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="15dp"
    android:layout_marginTop="10dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/md_theme_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contraint_forum_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <ImageView
                android:id="@+id/iv_profile_pict"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/background_circle"
                android:backgroundTint="#373643"
                android:src="@mipmap/ic_study_connect_foreground"
                android:contentDescription="@string/text_profile"
                app:layout_constraintBottom_toBottomOf="@id/contraint_forum_card"
                app:layout_constraintStart_toStartOf="@id/contraint_forum_card"
                app:layout_constraintTop_toTopOf="@id/contraint_forum_card" />

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/text_nama_anda"
                app:layout_constraintStart_toEndOf="@+id/iv_profile_pict"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_jam_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:text="@string/text_jam"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_profile_pict"
                app:layout_constraintTop_toBottomOf="@+id/tv_profile_name" />

            <ImageView
                android:id="@+id/iv_edit_forum"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ic_more"
                android:backgroundTint="@color/black"
                android:contentDescription="@string/text_forum"
                app:layout_constraintBottom_toBottomOf="@id/contraint_forum_card"
                app:layout_constraintEnd_toEndOf="@id/contraint_forum_card"
                app:layout_constraintTop_toTopOf="@id/contraint_forum_card" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_deskripsi_forum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/text_deskripsi_pengumuman" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fileCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/gambar"
                    android:layout_width="wrap_content"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Gambar"
                    android:src="@drawable/powder_smoke" />

                <TextView
                    android:id="@+id/nama_gambar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/text_nama_gambar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pdfCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardCornerRadius="15dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.github.barteksc.pdfviewer.PDFView
                    android:id="@+id/pdfView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <TextView
                    android:id="@+id/namaPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:padding="10dp"
                    android:text="@string/text_nama_gambar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_outline" />

        <TextView
            android:visibility="gone"
            android:id="@+id/tv_add_forum_komen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/text_tambah_komentar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>