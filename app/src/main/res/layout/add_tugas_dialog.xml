<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/text_buat"
        android:textAlignment="center"
        android:textSize="30sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_theme_outline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTugas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:padding="15dp"
        android:text="@string/text_tugas"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:cornerRadius="0dp"
        app:icon="@drawable/baseline_description_24"
        app:iconPadding="20dp"
        app:iconSize="40sp"
        app:iconTint="@color/black" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddKuis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:padding="15dp"
        android:text="@string/text_kuis"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:cornerRadius="0dp"
        app:icon="@drawable/baseline_description_24"
        app:iconPadding="20dp"
        app:iconSize="40sp"
        app:iconTint="@color/black" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddPertanyaan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:padding="15dp"
        android:text="@string/text_pertanyaan"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:cornerRadius="0dp"
        app:icon="@drawable/baseline_question_mark_24"
        app:iconPadding="20dp"
        app:iconSize="40sp"
        app:iconTint="@color/black" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddMateri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:padding="15dp"
        android:text="@string/text_materi"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:cornerRadius="0dp"
        app:icon="@drawable/baseline_book_24"
        app:iconPadding="20dp"
        app:iconSize="40sp"
        app:iconTint="@color/black" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_theme_outline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddTopik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:padding="15dp"
        android:text="@string/text_topik"
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="25sp"
        app:cornerRadius="0dp"
        app:icon="@drawable/baseline_view_list_24"
        app:iconPadding="20dp"
        app:iconSize="40sp"
        app:iconTint="@color/black" />
</LinearLayout>